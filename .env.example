# Copy to .env.local and fill in. Never commit .env.local.

# CoinGecko API key (free "Demo" key from https://www.coingecko.com/en/api)
COINGECKO_API_KEY=

# "demo" (default) or "pro" if you have a paid key
COINGECKO_API_PLAN=demo

# Optional: calls-per-minute ceiling (default 90 with a key, 8 without; the Demo plan allows 100)
# COINGECKO_CALLS_PER_MINUTE=90

# Optional: monthly call budget shown in the header meter (default 10,000 for Demo)
# COINGECKO_MONTHLY_LIMIT=10000

# Optional: GitHub token (free account, no scopes needed). Raises GitHub's limit
# from 60 to 5,000 requests/hour for developer-activity data.
# GITHUB_TOKEN=

# Optional: CryptoPanic key for coin-tagged news (free at https://cryptopanic.com/developers/api/).
# Without it, news comes from Cointelegraph / CoinDesk / Decrypt / The Block RSS feeds.
# CRYPTOPANIC_API_KEY=

# Optional: where the local database lives (default: data/coinscope.db)
# COINSCOPE_DB=

# Hosted database (Turso). Required on Vercel, whose disk is read-only. When set,
# the app uses Turso instead of the local file. Copy local data over with: npm run db:migrate-turso
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
